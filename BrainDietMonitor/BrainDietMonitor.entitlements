<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the BrainDietMonitor extension target.
  Add this file under the extension target's Signing & Capabilities.
  Requires the granted com.apple.developer.family-controls entitlement from Apple.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.family-controls</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.jackboring.braindiet.shared</string>
    </array>
</dict>
</plist>
